{
  "name": "@devbridge/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first command line interface for DevBridge",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
