    }
  },
  "files": ["dist"],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^5.0.2"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@devbridge/core": "workspace:*",
    "@devbridge/engine": "workspace:*"
  }
}
