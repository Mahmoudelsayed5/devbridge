{
  "name": "devbridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Developer tools for transforming code, APIs and other development artifacts.",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:generated": "node scripts/verify-generated.mjs",
    "verify:generated:strict": "node scripts/verify-generated.mjs --strict",
    "devbridge": "node packages/cli/dist/bin.js",
    "build:web": "pnpm --filter @devbridge/web build",
    "dev:web": "pnpm --filter @devbridge/web dev",
    "build:vscode": "pnpm --filter devbridge-vscode build",
    "package:vscode": "pnpm --filter devbridge-vscode package",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "license": "MIT"
}
